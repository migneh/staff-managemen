# مسار قاعدة البيانات (اختياري)
DB_PATH=./data/staff.db
# المنطقة الزمنية للتقارير التلقائية (اختياري)
TZ=Asia/Riyadh
# اختياري: معرف بوت التكتات الخارجي لتقييد القراءة على رسائله فقط
