# توكن البوت من Discord Developer Portal
DISCORD_TOKEN=
# معرف تطبيق البوت (Application ID)
CLIENT_ID=
# معرف السيرفر (البوت خاص بسيرفر واحد)
GUILD_ID=
# مسار قاعدة البيانات (اختياري)
DB_PATH=./data/staff.db
# المنطقة الزمنية للتقارير التلقائية (اختياري)
TZ=Asia/Riyadh
# اختياري: معرف بوت التكتات الخارجي لتقييد القراءة على رسائله فقط
TICKET_LOG_BOT_ID=
# مجلد النسخ الاحتياطية وعدد النسخ المحتفظ بها (اختياري)
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Health endpoint اختياري — لا يُشغّل إلا عند تحديد المنفذ
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
# ضع رمزاً لحماية /healthz و /metrics عند كشف المنفذ
HEALTH_TOKEN=
